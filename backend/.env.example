# Local development only. On OpenShift, set these as Secret / ConfigMap / CI environment variables.

# OpenShift cluster
OPENSHIFT_API_URL=https://api.your-cluster.example.com:6443
OPENSHIFT_TOKEN=sha256~your_token_here

# IBM watsonx.ai
WATSONX_API_KEY=your_watsonx_api_key_here
WATSONX_BASE_URL=
WATSONX_PROJECT_ID=your_watsonx_project_id_here
WATSONX_MODEL=

# IBM Consulting Advantage (ICA) — key must start with sk-


# Comma-separated allowed origins (not needed when frontend proxies via nginx)
CORS_ORIGINS=http://localhost:5173

ENVIRONMENT=development
